# Copy to local/confluence.env and fill in. local/run_api.sh sources that file
# if it exists, so the API process gets these without them ever being typed on
# a command line (where they would land in shell history) or committed.
CONFLUENCE_URL=https://confluence.your-company.example
CONFLUENCE_USERNAME=your.username
CONFLUENCE_PASSWORD=your-password
# CONFLUENCE_API_TOKEN=... # accepted instead of CONFLUENCE_PASSWORD
CONFLUENCE_SPACE=AISMT
