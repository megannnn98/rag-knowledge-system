# Copy to local/infra.env and change the credentials before using this beyond a
# local workstation. Read by BOTH docker compose (--env-file) and
# local/run_api.sh, so the containers and the API can never drift apart.
POSTGRES_USER=raguser
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ragdb
QDRANT_API_KEY=change-me

# Host ports, kept off the defaults so this stack cannot collide with another
# PostgreSQL/Qdrant already running on the machine. Must match
# local/docker-compose.override.yml.
POSTGRES_HOST_PORT=55433
QDRANT_HOST_PORT=6335

# Only needed by the langfuse service, which local/run_api.sh does not start.
LANGFUSE_NEXTAUTH_SECRET=unused-local
LANGFUSE_SALT=unused-local
